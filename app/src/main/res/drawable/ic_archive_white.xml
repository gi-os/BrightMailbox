<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60.0dp" android:height="60.0dp"
    android:viewportWidth="60.0" android:viewportHeight="60.0">

    <!--
      Archive: a box with a lid.

      The first attempt was an arrow going down into an open tray, which reads as
      download — the arrow is the loudest thing in it and a downward arrow means "save
      this to the phone" everywhere else on the phone. A lidded box has no arrow to
      misread: it is a thing you put mail into and can open again, which is exactly what
      archive does.

      Not ic_trash, which light-sdk does have. Archive MOVEs to All Mail; delete does not.
      An icon that says "delete" over a button that archives teaches someone to be afraid
      of a button that was always safe.

      60x60 viewport and 4.0 stroke, matching the SDK icons beside it.
    -->

    <!-- The lid -->
    <path android:pathData="M10,14 L50,14 L50,23 L10,23 Z"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- The box under it -->
    <path android:pathData="M14,23 L14,46 L46,46 L46,23"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- The handle. Without it the box reads as an empty rectangle at 28px. -->
    <path android:pathData="M24,33 L36,33"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>

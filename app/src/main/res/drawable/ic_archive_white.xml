<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60.0dp" android:height="60.0dp"
    android:viewportWidth="60.0" android:viewportHeight="60.0">

    <!--
      Archive: a message going down into a box.

      Drawn here rather than copied, because light-sdk has no archive icon — it has 105
      and none of them is this. The one that looked close is ic_trash, and using it would
      be a lie on a mail app: archive MOVES a message to All Mail, delete does not, and an
      icon that says "delete" over a button that archives is how somebody learns to be
      afraid of a button that was always safe.

      Geometry is the SDK's so it sits level with ic_reply_white and ic_back_white beside
      it: 60x60 viewport, 4.0 stroke, round caps and joins, pure white.
    -->

    <!-- Down arrow: the message -->
    <path android:pathData="M30,11 L30,32"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M21.5,24 L30,32.5 L38.5,24"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- The box it lands in: open at the top, so this reads as "put away", not "delete" -->
    <path android:pathData="M13,38 L13,47 L47,47 L47,38"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>

<!--
  More: three rules. Three marks on one line read as punctuation at 29dp; three lines read
  as a menu, which is what the panel behind it holds.

  Pigeonholes set: a sorting case and the cards that move through it. 24-unit viewport,
  2.2 stroke, round caps and joins, white and tinted where it is used. Plain paths only,
  every coordinate already in place, so nothing here is scaled or transformed at runtime.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2" android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M 5.2 7 H 18.8 M 5.2 12 H 18.8 M 5.2 17 H 18.8"/>
</vector>

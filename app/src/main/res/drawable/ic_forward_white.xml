<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60.0dp" android:height="60.0dp"
    android:viewportWidth="60.0" android:viewportHeight="60.0">

    <!--
      Forward: reply's arrow, the other way round.

      The same glyph as ic_reply_white mirrored about the vertical centre line, which is
      what every mail client draws and what makes the pair read as a pair. Written out
      rather than flipped at draw time with a negative scaleX, because a mirrored Image
      also mirrors its touch bounds in some Compose versions and this icon is 2 grid units
      wide on a 3.9" panel — there is no room to be approximately right about where it is.

      60x60 viewport and 4.0 stroke, matching the SDK icons it sits beside in the bar.
    -->

    <!-- Arrowhead, pointing right -->
    <path android:pathData="M38,20 L48,30 L38,40"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />

    <!-- The line it came in on, turning down at the end -->
    <path android:pathData="M48,30 L26,30 C17,30 12,35 12,44 L12,47"
        android:strokeColor="#FFFFFFFF" android:strokeWidth="4.0"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>

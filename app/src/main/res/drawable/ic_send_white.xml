        android:pathData="M 8.44 9.21 L 17.10 4.61 Q 18.51 3.85 19.26 5.27 L 22.22 10.83 Q 22.97 12.24 21.56 12.99 L 12.90 17.59 Q 11.49 18.35 10.74 16.93 L 7.78 11.37 Q 7.03 9.96 8.44 9.21 Z"/>
